# Copy to .env. Any Postgres 14+ works. Hosted URLs (Neon, Supabase, ...) can be pasted as-is:
# plain postgresql:// is accepted and pooled connections are handled.
# The default below targets the optional `docker compose up -d` Postgres.
DATABASE_URL=postgresql+psycopg://lender_matching:lender_matching@localhost:5433/lender_matching

# Using a Postgres you already run locally (port 5432) instead:
# DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/lender_matching

# auto = Hatchet when a token is present, otherwise in-process. Force with: hatchet | sync
UNDERWRITING_MODE=auto

# Generate with `make hatchet-token`, then paste here.
HATCHET_CLIENT_TOKEN=
# tls (the SDK default) is required for Hatchet Cloud; "none" is only for local hatchet-lite.
# HATCHET_CLIENT_TLS_STRATEGY=none

# PDF ingestion needs one model provider. With both keys set, EXTRACTION_PROVIDER picks
# (auto = Anthropic if its key is present, else OpenAI).
EXTRACTION_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint (Azure: https://<resource>.openai.azure.com/openai/v1;
# then OPENAI_EXTRACTION_MODEL is the deployment name).
OPENAI_BASE_URL=

# PDF ingestion needs a live key (ANTHROPIC_API_KEY or OPENAI_API_KEY above); there is no
# key-less mode. Without one, "Onboard from PDF" fails with a clear "no model connected" error.
# EXTRACTION_MODEL=claude-opus-5
# OPENAI_EXTRACTION_MODEL=gpt-4.1
UPLOADS_DIR=uploads
