  "uncertainties": [
    {
      "item": "Multiple contacts and submission emails",
      "reason": "The document lists Stephanie Costa, Donald Wampler, and separate submission inboxes for credit, documents, and funding, but the schema has only one contact_name/email/phone.",
      "suggestion": "Use Stephanie Costa as primary contact and store credit@apexcommercial.com, docs@apexcommercial.com, funding@apexcommercial.com in lender notes if supported."
    },
    {
      "item": "Excluded 'Fad Medical'",
      "reason": "No catalog field or enum distinguishes fad medical equipment from ordinary medical equipment or medical-practice essential-use equipment.",
      "suggestion": "Add a fad_medical equipment subtype or manual review flag."
    },
    {
      "item": "Medical license good standing and disciplinary actions",
      "reason": "The document requires active healthcare licenses in good standing with no significant or recent disciplinary actions, but available fields only capture whether the guarantor is a licensed medical professional and years licensed.",
      "suggestion": "Add fields for license_active, license_good_standing, and recent_disciplinary_actions."
    },
    {
      "item": "Medical essential-use requirement",
      "reason": "The document requires essential-use equipment for the practice, but the catalog does not include an essential-use field.",
      "suggestion": "Add equipment_essential_use boolean or require manual review for medical programs."
    },
    {
      "item": "Corp-only profitability, leverage, and cash-flow review",
      "reason": "The corp-only program requires financial statements showing profitability, acceptable leverage, and adequate cash flow, but no catalog fields define profitability, leverage, cash flow, or thresholds.",
      "suggestion": "Add financial-ratio fields and lender-specific thresholds, or route corp-only submissions to manual review."
    },
    {
      "item": "Comparable business credit 'paid as agreed'",
      "reason": "The corp-only guideline says comparable business credit must report as paid as agreed; the catalog has comparable_credit_pct but no field for paid-as-agreed status on business credit reports.",
      "suggestion": "Add comparable_credit_paid_as_agreed boolean."
    },
    {
      "item": "A+ Waste Management exclusion for bins/containers",
      "reason": "A+ eligible list says Waste Management is eligible with 'no bins/containers', but the equipment catalog has no bins/containers subtype.",
      "suggestion": "Add equipment subtype for waste bins/containers or a manual exclusion flag."
    },
    {
      "item": "A+ eligible industries/equipment wording",
      "reason": "The A+ section says to call to discuss other industries/equipment, so the published list was modeled as a hard eligibility rule for the published A+ pricing even though exceptions may be considered manually.",
      "suggestion": "Allow exception workflow for non-listed A+ industries/equipment."
    },
    {
      "item": "Nail salons mapped to beauty_salon",
      "reason": "The catalog has beauty_salon but not nail_salon; mapping nail salons to beauty_salon may exclude broader beauty salon businesses than the document literally states.",
      "suggestion": "Add nail_salon as a distinct industry option."
    },
    {
      "item": "Trucking exclusion scope",
      "reason": "The document excludes 'Trucking (Local & Long Haul)' but A+ eligible types include 'Vocational Trucks'. This was modeled as an excluded trucking industry, not a blanket truck-equipment exclusion.",
      "suggestion": "Confirm whether truck equipment for non-trucking industries is acceptable and whether local/long-haul trucking should be a separate industry subtype."
    },
    {
      "item": "Rate-table loan amount and term ranges",
      "reason": "Loan amount and term ranges appear in pricing tables rather than explicit underwriting maximums. They were modeled as hard program limits because no other program amount/term limits are stated.",
      "suggestion": "Confirm whether amounts or terms outside the rate tables are declines, custom pricing, or manual-review exceptions."
    },
    {
      "item": "Private party sales and sale-leasebacks",
      "reason": "The excluded list includes Private Party Sales and Sale-Leasebacks globally, while the A+ program separately states 'No Private Party Sales'. These were modeled as global exclusions with a repeated A+ private-party rule.",
      "suggestion": "Confirm whether any program exceptions exist for private party or sale-leaseback transactions."
    },
    {
      "item": "Weaker collateral pricing increase",
      "reason": "The document notes '+.50% to 1.00% for weaker collateral', but the catalog has no weak-collateral field and rates are display-only.",
